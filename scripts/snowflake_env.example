# Copy to a file outside the repository, fill in, chmod 600, and source it (or set ENPAL_ENV_FILE to it). Read by profiles.yml (targets test and prod) and scripts/dq_report.sh.
# Key-pair auth: the public key is set on the user with  alter user <user> set rsa_public_key = '...';
export SNOWFLAKE_ACCOUNT="<orgname>-<account_name>"
export SNOWFLAKE_USER="ENPAL_DBT_USER"
export SNOWFLAKE_PRIVATE_KEY_PATH="<path to the private key>.p8"
